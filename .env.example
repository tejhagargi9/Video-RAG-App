# .env.example for Video-RAG-App
# Copy this file to `.env` (backend) or set these variables in your environment.
# Do NOT commit your real secrets. Use a real `.env` or your platform's secret manager.

# Pinecone (required if using Pinecone vector store)
PINECONE_API_KEY=your_pinecone_api_key_here
# Optional: name of the Pinecone index to use (the code defaults to "videorag")
PINECONE_INDEX_NAME=videorag

# Apify (required for Instagram transcript and some YouTube Apify-based endpoints)
APIFY_TOKEN=your_apify_token_here

# YouTube Data API (optional, used for richer metadata)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI / LLM credentials (used by langchain-openai and embeddings)
OPENAI_API_KEY=your_openai_api_key_here
# Depending on the LLM/embedding provider and the langchain adapters you use, you may need additional provider-specific environment variables.

# Frontend (Vite) - put these in Frontend/.env or in your dev environment
# Example: VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Notes:
# - On Windows cmd.exe: use `set VAR=value` for temporary session values.
# - In PowerShell: use `$env:VAR = 'value'` to set for current session.
# - In Unix shells (bash/zsh): use `export VAR=value` or create a `.env` file and a tool like direnv to load it.

# Example (Windows cmd.exe, temporary):
# set PINECONE_API_KEY=abc123
# set APIFY_TOKEN=abcdef
# set OPENAI_API_KEY=sk-...

# Example (Unix / .env loader):
# PINECONE_API_KEY=abc123
# APIFY_TOKEN=abcdef
# OPENAI_API_KEY=sk-...
